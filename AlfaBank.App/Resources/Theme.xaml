<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Стили оформления программы: единая палитра, шрифты и элементы интерфейса.
      Палитра построена вокруг одного фирменного синего цвета и трёх смысловых
      цветов состояния: зелёный — результат в пользу пользователя, красный —
      ошибка или неблагоприятный исход, серый — нейтральная информация.
    -->

    <!-- Фирменные цвета -->
    <Color x:Key="AccentColor">#1B5E9B</Color>
    <Color x:Key="AccentDarkColor">#103F63</Color>
    <Color x:Key="AccentLightColor">#E8F1F8</Color>

    <!--
      Фирменный красный: полоса шапки, акценты и линии под заголовками.
      Оттенок отделён от красного ошибок, который заметно темнее,
      иначе оформление и смысл цвета смешивались бы.
    -->
    <Color x:Key="BrandRedColor">#E31E24</Color>
    <Color x:Key="BrandRedDarkColor">#A8141A</Color>
    <Color x:Key="BrandRedLightColor">#FDEBEC</Color>

    <!-- Фоновые и линейные цвета -->
    <Color x:Key="SurfaceColor">#F4F6F8</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#D3DBE2</Color>

    <!-- Смысловые цвета -->
    <Color x:Key="SuccessColor">#1E7F45</Color>
    <Color x:Key="SuccessSurfaceColor">#E7F5EC</Color>
    <Color x:Key="DangerColor">#A3201A</Color>
    <Color x:Key="DangerSurfaceColor">#FBEAE9</Color>
    <Color x:Key="NeutralColor">#5A6672</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}" />
    <SolidColorBrush x:Key="BrandRedBrush" Color="{StaticResource BrandRedColor}" />
    <SolidColorBrush x:Key="BrandRedDarkBrush" Color="{StaticResource BrandRedDarkColor}" />
    <SolidColorBrush x:Key="BrandRedLightBrush" Color="{StaticResource BrandRedLightColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="{StaticResource SuccessSurfaceColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="{StaticResource DangerSurfaceColor}" />
    <SolidColorBrush x:Key="NeutralBrush" Color="{StaticResource NeutralColor}" />

    <!-- Заголовки и подписи полей -->
    <Style x:Key="PageHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#1A1A1A" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <!--
      Заголовок страницы с красной вертикальной чертой слева: фирменный акцент,
      который отделяет заголовок от содержимого и не занимает лишнего места.
    -->
    <Style x:Key="PageHeaderBarStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandRedBrush}" />
        <Setter Property="BorderThickness" Value="4,0,0,0" />
        <Setter Property="Padding" Value="10,0,0,0" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#1A1A1A" />
    </Style>

    <!-- Заголовок раздела с красной чертой: та же идея, но мельче. -->
    <Style x:Key="SectionHeaderBarStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandRedBrush}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Foreground" Value="#333333" />
    </Style>

    <Style x:Key="HintStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#7A8794" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!--
      Строка «подпись + значение» для карточек с подробностями.
      Подпись прижата влево фиксированной шириной, значение занимает остаток строки
      и переносится по словам. Такая схема не зависит от объявления строк сетки,
      поэтому поля не могут наложиться друг на друга.
    -->
    <Style x:Key="FormRowStyle" TargetType="DockPanel">
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style x:Key="FormLabelStyle" TargetType="TextBlock">
        <Setter Property="Width" Value="190" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Foreground" Value="#5A6672" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
      Сообщение под формой: цвет выбирается триггером по виду сообщения,
      поэтому обычные информационные сообщения не выглядят как ошибки.
    -->
    <Style x:Key="StatusMessageStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,10,0,0" />
        <Setter Property="Foreground" Value="{StaticResource NeutralBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
      Главное действие страницы: фирменный красный, как кнопка отправки
      на официальном сайте банка. Красный отказа на фоне такого красного
      был бы неразличим, поэтому отказ вынесен в отдельную рамку (см. ниже).
    -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{StaticResource BrandRedBrush}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource BrandRedDarkBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#E0B4B6" />
                            <Setter Property="Foreground" Value="#FFF0F0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Foreground" Value="#1A1A1A" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource BrandRedLightBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource BrandRedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#EDF1F4" />
                            <Setter Property="Foreground" Value="#A8B3BC" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кнопка на цветной шапке: белая с полупрозрачной заливкой, чтобы не спорить с красным. -->
    <Style x:Key="HeaderButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="#33FFFFFF"
                            BorderBrush="#66FFFFFF"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#55FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Опасное действие: отказ по заявке. Рамка намеренно нейтральная, а не красная:
      главная кнопка страницы и так фирменно-красная, иначе одобрение и отказ
      выглядели бы одинаково. Красным остаётся только текст — сам смысл отказа.
    -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="#B8C4CE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource DangerSurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#EDF1F4" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#D3DBE2" />
                            <Setter Property="Foreground" Value="#A8B3BC" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Таблицы: аккуратный заголовок, чередование строк, выделение выбранной строки -->
    <Style x:Key="DataGridHeaderStyle" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="RowHeight" Value="30" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="RowBackground" Value="{StaticResource CardBrush}" />
        <Setter Property="AlternatingRowBackground" Value="#F7F9FB" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="HorizontalGridLinesBrush" Value="#E7EBEF" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F2F4F6" />
                    <Setter Property="Foreground" Value="#1A1A1A" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="8,7" />
                    <!-- Тонкая красная линия под шапкой таблицы: фирменный акцент. -->
                    <Setter Property="BorderBrush" Value="{StaticResource BrandRedBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,4" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Карточка со смягчённой рамкой вместо резкой обводки -->
    <Style x:Key="SummaryCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="MinWidth" Value="190" />
    </Style>

    <!-- Поле ввода с единым оформлением -->
    <Style x:Key="InputBoxStyle" TargetType="TextBox">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrandRedBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrandRedDarkBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrandRedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Поле выбора даты оформляется так же, как остальные поля ввода. -->
    <Style x:Key="InputDatePickerStyle" TargetType="DatePicker">
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="DataGridWrapTextStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
