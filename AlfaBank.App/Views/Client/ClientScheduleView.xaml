<UserControl x:Class="AlfaBank.App.Views.Client.ClientScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AlfaBank.App.Converters"
             Background="{StaticResource SurfaceBrush}">

    <UserControl.Resources>
        <converters:DateOnlyConverter x:Key="DateOnlyConverter" />
    </UserControl.Resources>

    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top"
                   Text="Графики платежей по кредитам"
                   Style="{StaticResource PageHeaderStyle}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Кредит"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Credits}"
                          SelectedItem="{Binding SelectedCredit}"
                          DisplayMemberPath="ProductName"
                          Padding="6,5" />

                <Button Grid.Column="2"
                        Content="Показать график"
                        Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ReloadScheduleCommand}" />
            </Grid>

            <TextBlock Grid.Row="1"
                       Margin="0,0,0,8"
                       Foreground="#555555"
                       Text="{Binding SelectedCredit, StringFormat='Кредит: {}{0:ProductName}, сумма {}{0:Amount} ₽'}" />

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding ScheduleItems}"
                      Style="{StaticResource DataGridHeaderStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="50" />
                    <DataGridTextColumn Header="Дата платежа" Binding="{Binding DueDate, Converter={StaticResource DateOnlyConverter}}" Width="120" />
                    <DataGridTextColumn Header="Платёж, ₽" Binding="{Binding PaymentAmount, StringFormat='{}{0:N2}'}" Width="*" />
                    <DataGridTextColumn Header="Проценты, ₽" Binding="{Binding InterestAmount, StringFormat='{}{0:N2}'}" Width="*" />
                    <DataGridTextColumn Header="Основной долг, ₽" Binding="{Binding PrincipalAmount, StringFormat='{}{0:N2}'}" Width="*" />
                    <DataGridTextColumn Header="Остаток, ₽" Binding="{Binding RemainingDebt, StringFormat='{}{0:N2}'}" Width="*" />
                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="*" />
                    <DataGridTextColumn Header="Факт. оплата" Binding="{Binding PaidOn, Converter={StaticResource DateOnlyConverter}}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="3"
                       Style="{StaticResource StatusMessageStyle}"
                       Text="{Binding StatusMessage}" />
        </Grid>
    </DockPanel>
</UserControl>