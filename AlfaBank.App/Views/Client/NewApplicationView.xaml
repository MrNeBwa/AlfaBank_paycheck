<UserControl x:Class="AlfaBank.App.Views.Client.NewApplicationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">

    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top"
                   Text="Подача заявки на кредит"
                   Style="{StaticResource PageHeaderStyle}" />

        <Border Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="20"
                VerticalAlignment="Top"
                MaxWidth="760"
                HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Кредитный продукт" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct}"
                          DisplayMemberPath="Name"
                          Padding="6,5"
                          Margin="0,0,0,8" />

                <TextBlock Text="Желаемая сумма кредита, ₽" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,5"
                         Margin="0,0,0,8" />

                <TextBlock Text="Срок кредита, месяцев" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding TermText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,5"
                         Margin="0,0,0,8" />

                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,4,0,16">
                    <StackPanel>
                        <TextBlock Text="Предварительный ежемесячный платёж, ₽"
                                   Foreground="#555555" />
                        <TextBlock Text="{Binding CalculatedPayment, StringFormat='{}{0:N2}'}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentDarkBrush}" />
                        <TextBlock Text="{Binding LimitsText}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="#555555" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Отправить заявку"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SubmitCommand}" />

                    <Button Content="Обновить продукты"
                            Margin="12,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding LoadProductsCommand}" />
                </StackPanel>

                <TextBlock Style="{StaticResource StatusMessageStyle}" Text="{Binding StatusMessage}" />
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>