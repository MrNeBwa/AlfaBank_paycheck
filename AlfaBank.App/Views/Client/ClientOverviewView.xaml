<UserControl x:Class="AlfaBank.App.Views.Client.ClientOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AlfaBank.App.Converters"
             xmlns:infra="clr-namespace:AlfaBank.App.Infrastructure"
             Background="{StaticResource SurfaceBrush}">

    <UserControl.Resources>
        <converters:DateTimeConverter x:Key="DateTimeConverter" />
        <converters:StatusToBrushConverter x:Key="StatusToBrush" />
    </UserControl.Resources>

    <DockPanel Margin="16">
        <Button DockPanel.Dock="Bottom"
                Content="Обновить данные"
                HorizontalAlignment="Left"
                Margin="0,12,0,0"
                Style="{StaticResource SecondaryButtonStyle}"
                Command="{Binding ReloadCommand}" />

        <!-- Прокрутка: в невысоком окне сводка и таблица заявок должны оставаться доступны. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource PageHeaderBarStyle}">
                <TextBlock Text="Мои кредиты и заявки"
                           Style="{StaticResource PageHeaderStyle}"
                           Margin="0" />
            </Border>

                <!-- Перенос карточек: в узком окне они складываются в несколько рядов,
                     а не сжимаются в нечитаемую полосу. -->
                <WrapPanel Margin="0,0,0,16">
                    <Border Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Заявок всего" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding ApplicationsTotalCount}" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="На рассмотрении" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding ApplicationsNewCount}" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Одобрено заявок" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding ApplicationsApprovedCount}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Действующих кредитов" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding ActiveCreditsCount}" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Остаток долга, ₽" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding RemainingDebtTotal, StringFormat='{}{0:N2}'}" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Внесено, ₽" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding PaidTotal, StringFormat='{}{0:N2}'}" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <TextBlock Text="Мои заявки" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8" />

                <DataGrid ItemsSource="{Binding Applications}"
                          infra:ClearSelection.IsEnabled="True"
                          Style="{StaticResource DataGridHeaderStyle}"
                          MinHeight="160"
                          MaxHeight="330">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50" />
                        <DataGridTextColumn Header="Продукт" Binding="{Binding ProductName}" Width="2*" />
                        <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Amount, StringFormat='{}{0:N2}'}" Width="*" />
                        <DataGridTextColumn Header="Срок, мес." Binding="{Binding TermMonths}" Width="90" />
                        <DataGridTextColumn Header="Платёж, ₽" Binding="{Binding MonthlyPayment, StringFormat='{}{0:N2}'}" Width="*" />
                        <DataGridTemplateColumn Header="Статус" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusText}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Подана" Binding="{Binding CreatedAt, Converter={StaticResource DateTimeConverter}}" Width="110" />
                        <DataGridTextColumn Header="Комментарий банка" Binding="{Binding DecisionComment}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Style="{StaticResource StatusMessageStyle}" Text="{Binding StatusMessage}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
