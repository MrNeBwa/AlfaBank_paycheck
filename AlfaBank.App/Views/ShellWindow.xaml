<Window x:Class="AlfaBank.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vmClient="clr-namespace:AlfaBank.App.ViewModels.Client"
        xmlns:vmSpecialist="clr-namespace:AlfaBank.App.ViewModels.Specialist"
        xmlns:vmAdmin="clr-namespace:AlfaBank.App.ViewModels.Admin"
        xmlns:viewClient="clr-namespace:AlfaBank.App.Views.Client"
        xmlns:viewSpecialist="clr-namespace:AlfaBank.App.Views.Specialist"
        xmlns:viewAdmin="clr-namespace:AlfaBank.App.Views.Admin"
        Title="Альфабанк — автоматизированная система кредитования"
        Width="1180"
        Height="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vmClient:ClientOverviewViewModel}">
            <viewClient:ClientOverviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmClient:NewApplicationViewModel}">
            <viewClient:NewApplicationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmClient:ClientScheduleViewModel}">
            <viewClient:ClientScheduleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSpecialist:ApplicationQueueViewModel}">
            <viewSpecialist:ApplicationQueueView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSpecialist:ApplicationReviewViewModel}">
            <viewSpecialist:ApplicationReviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSpecialist:CreditPortfolioViewModel}">
            <viewSpecialist:CreditPortfolioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmAdmin:UserManagementViewModel}">
            <viewAdmin:UserManagementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmAdmin:ProductManagementViewModel}">
            <viewAdmin:ProductManagementView />
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="{StaticResource BrandRedDarkColor}" />
                        <GradientStop Offset="1" Color="{StaticResource BrandRedColor}" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="4"
                                Height="26"
                                CornerRadius="2"
                                Background="White"
                                Margin="0,0,10,0" />
                        <TextBlock Text="Альфабанк"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="— автоматизированная система кредитования"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#FBDDDE" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserFullName}"
                                       Foreground="White"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding UserRole}"
                                       Foreground="#FBDDDE"
                                       FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="Выход"
                            Style="{StaticResource HeaderButtonStyle}"
                            Command="{Binding LogOutCommand}" />
                </Grid>
            </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0"
                     Margin="10"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem}"
                     Background="{StaticResource CardBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     BorderThickness="1"
                     Padding="4"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,10" />
                        <Setter Property="Margin" Value="2" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="Transparent"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BrandRedLightBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <!-- Выбранный пункт подсвечивается фирменным красным. -->
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BrandRedBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#333333" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ContentControl Grid.Column="1"
                            Margin="0,10,10,10"
                            Content="{Binding Navigation.CurrentPage}" />
        </Grid>
    </DockPanel>
</Window>