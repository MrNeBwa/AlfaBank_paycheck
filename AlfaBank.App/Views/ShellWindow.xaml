<Window x:Class="AlfaBank.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vmClient="clr-namespace:AlfaBank.App.ViewModels.Client"
        xmlns:vmSpecialist="clr-namespace:AlfaBank.App.ViewModels.Specialist"
        xmlns:vmAdmin="clr-namespace:AlfaBank.App.ViewModels.Admin"
        xmlns:viewClient="clr-namespace:AlfaBank.App.Views.Client"
        xmlns:viewSpecialist="clr-namespace:AlfaBank.App.Views.Specialist"
        xmlns:viewAdmin="clr-namespace:AlfaBank.App.Views.Admin"
        Title="Альфабанк — автоматизированная система кредитования"
        Width="1180"
        Height="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vmClient:ClientOverviewViewModel}">
            <viewClient:ClientOverviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmClient:NewApplicationViewModel}">
            <viewClient:NewApplicationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmClient:ClientScheduleViewModel}">
            <viewClient:ClientScheduleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSpecialist:ApplicationQueueViewModel}">
            <viewSpecialist:ApplicationQueueView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSpecialist:ApplicationReviewViewModel}">
            <viewSpecialist:ApplicationReviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSpecialist:CreditPortfolioViewModel}">
            <viewSpecialist:CreditPortfolioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmAdmin:UserManagementViewModel}">
            <viewAdmin:UserManagementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmAdmin:ProductManagementViewModel}">
            <viewAdmin:ProductManagementView />
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}">
            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Альфабанк"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="— автоматизированная система кредитования"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#D6E4F0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding UserFullName}"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding UserRole}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#D6E4F0" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Выход"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding LogOutCommand}" />
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0"
                     Margin="10"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem}"
                     Background="White"
                     BorderBrush="{StaticResource BorderBrush}"
                     BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,9" />
                        <Setter Property="Margin" Value="2" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" FontSize="14" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ContentControl Grid.Column="1"
                            Margin="0,10,10,10"
                            Content="{Binding Navigation.CurrentPage}" />
        </Grid>
    </DockPanel>
</Window>