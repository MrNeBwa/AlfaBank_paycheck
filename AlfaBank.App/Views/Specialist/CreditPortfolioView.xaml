<UserControl x:Class="AlfaBank.App.Views.Specialist.CreditPortfolioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AlfaBank.App.Converters"
             xmlns:infra="clr-namespace:AlfaBank.App.Infrastructure"
             Background="{StaticResource SurfaceBrush}">

    <UserControl.Resources>
        <converters:DateOnlyConverter x:Key="DateOnlyConverter" />
        <converters:StatusToBrushConverter x:Key="StatusToBrush" />
    </UserControl.Resources>

    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Поиск"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />

            <TextBox Grid.Column="1"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource InputBoxStyle}" />

            <Button Grid.Column="2"
                    Content="Найти"
                    Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ReloadCommand}" />
        </Grid>

        <TextBlock DockPanel.Dock="Bottom"
                   Style="{StaticResource StatusMessageStyle}"
                   Text="{Binding StatusMessage}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="200" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                      Margin="0,0,0,12"
                      ItemsSource="{Binding Credits}"
                      SelectedItem="{Binding SelectedCredit}"
                      infra:ClearSelection.IsEnabled="True"
                      Style="{StaticResource DataGridHeaderStyle}">
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding SelectCreditCommand}" />
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50" />
                    <DataGridTextColumn Header="Клиент" Binding="{Binding ClientFullName}" Width="2*" ElementStyle="{StaticResource DataGridWrapTextStyle}" />
                    <DataGridTextColumn Header="Продукт" Binding="{Binding ProductName}" Width="2*" ElementStyle="{StaticResource DataGridWrapTextStyle}" />
                    <DataGridTextColumn Header="Выдан" Binding="{Binding IssuedOn, Converter={StaticResource DateOnlyConverter}}" Width="100" />
                    <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Amount, StringFormat='{}{0:N2}'}" Width="*" />
                    <DataGridTextColumn Header="Остаток, ₽" Binding="{Binding RemainingDebt, StringFormat='{}{0:N2}'}" Width="*" />
                    <DataGridTextColumn Header="Оплачено платежей" Binding="{Binding PaidPaymentsCount}" Width="120" />
                    <DataGridTemplateColumn Header="Статус" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="360" />
                    <!-- Узкое окно: колонка с формой платежа сжимается, иначе
                         график платежей выдавливается за левый край. -->
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,12,0" MinWidth="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="График платежей"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0,0,0,8" />

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ScheduleItems}"
                              SelectedItem="{Binding SelectedScheduleItem}"
                              infra:ClearSelection.IsEnabled="True"
                              Style="{StaticResource DataGridHeaderStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="45" />
                            <DataGridTextColumn Header="Дата" Binding="{Binding DueDate, Converter={StaticResource DateOnlyConverter}}" Width="100" />
                            <DataGridTextColumn Header="Платёж, ₽" Binding="{Binding PaymentAmount, StringFormat='{}{0:N2}'}" Width="*" />
                            <DataGridTextColumn Header="Остаток, ₽" Binding="{Binding RemainingDebt, StringFormat='{}{0:N2}'}" Width="*" />
                            <DataGridTemplateColumn Header="Статус" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Факт. оплата" Binding="{Binding PaidOn, Converter={StaticResource DateOnlyConverter}}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Загрузить график"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SelectCreditCommand}" />

                        <TextBlock Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#555555"
                                   Text="Выберите строку графика и зарегистрируйте платёж клиента." />
                    </StackPanel>
                </Grid>

                <!--
                    Прокрутка по вертикали: в невысоком окне кнопка регистрации
                    платежа уходила под нижний край и становилась недоступной.
                -->
                <Border Grid.Column="1"
                        Style="{StaticResource SummaryCardStyle}"
                        Margin="0"
                        Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="True">
                        <StackPanel>
                            <TextBlock Text="Регистрация платежа"
                                       Style="{StaticResource SectionHeaderStyle}"
                                       Margin="0,0,0,10" />

                            <TextBlock Text="План графика" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding SelectedScheduleItem, StringFormat='Платёж № {}{0:Number}, сумма {}{0:PaymentAmount} ₽'}"
                                       Margin="0,0,0,12"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="Дата платежа (ДД.ММ.ГГГГ)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding PaymentDateText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBoxStyle}"
                                     Margin="0,0,0,12" />

                            <TextBlock Text="Сумма платежа, ₽" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding PaymentAmountText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBoxStyle}"
                                     Margin="0,0,0,12" />

                            <TextBlock Text="Комментарий" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding PaymentComment, UpdateSourceTrigger=PropertyChanged}"
                                     Height="70"
                                     Style="{StaticResource InputBoxStyle}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,12" />

                            <Button Content="Зарегистрировать платёж"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding RegisterPaymentCommand}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>