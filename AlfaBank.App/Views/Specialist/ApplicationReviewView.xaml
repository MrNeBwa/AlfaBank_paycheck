<UserControl x:Class="AlfaBank.App.Views.Specialist.ApplicationReviewView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:converters="clr-namespace:AlfaBank.App.Converters"
              Background="{StaticResource SurfaceBrush}">

    <UserControl.Resources>
        <converters:DateOnlyConverter x:Key="DateOnlyConverter" />
        <converters:DateTimeConverter x:Key="DateTimeConverter" />
        <converters:StatusToBrushConverter x:Key="StatusToBrush" />
        <converters:BooleanToStatusBrushConverter x:Key="ApprovedBrush" />
    </UserControl.Resources>

    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Style="{StaticResource PageHeaderBarStyle}">
            <TextBlock Text="Проверка кредитной заявки"
                        Style="{StaticResource PageHeaderStyle}"
                        Margin="0"
                        TextWrapping="Wrap" />
        </Border>

        <TextBlock DockPanel.Dock="Bottom"
                    Style="{StaticResource StatusMessageStyle}"
                    Text="{Binding StatusMessage}"
                    TextWrapping="Wrap" />

        <!-- Прокрутка по вертикали: без неё в невысоком окне нижние поля недоступны. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="280" />
                    <ColumnDefinition Width="*" MinWidth="280" MaxWidth="440" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource SummaryCardStyle}"
                        Padding="18">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeaderBarStyle}">
                            <TextBlock Text="Данные клиента"
                                       Style="{StaticResource SectionHeaderStyle}" />
                        </Border>

                        <!-- Подпись и значение в строке: не требует объявления строк сетки,
                             поэтому поля не могут наложиться друг на друга. -->
                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="ФИО клиента"
                                       Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Text="{Binding Application.ClientFullName}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="Паспорт"
                                       Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Text="{Binding Application.PassportNumber}" TextWrapping="Wrap" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="Дата рождения"
                                       Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Text="{Binding Application.BirthDate, Converter={StaticResource DateOnlyConverter}}" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="Возраст, лет"
                                       Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Text="{Binding Application.AgeYears}" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="Адрес регистрации"
                                       Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Text="{Binding Application.RegistrationAddress}" TextWrapping="Wrap" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="Место работы"
                                       Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Text="{Binding Application.EmployerName}" TextWrapping="Wrap" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="Стаж, мес."
                                       Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Text="{Binding Application.EmploymentMonths}" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="Доход, ₽"
                                       Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Text="{Binding Application.MonthlyIncome, StringFormat='{}{0:N2}'}" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="Расходы, ₽"
                                       Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Text="{Binding Application.MonthlyExpenses, StringFormat='{}{0:N2}'}" />
                        </DockPanel>

                        <Border Style="{StaticResource SectionHeaderBarStyle}" Margin="0,18,0,8">
                            <TextBlock Text="Параметры кредита"
                                       Style="{StaticResource SectionHeaderStyle}" />
                        </Border>

                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="Продукт"
                                       Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Text="{Binding Application.ProductName}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="Сумма кредита, ₽"
                                       Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Text="{Binding Application.Amount, StringFormat='{}{0:N2}'}" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="Ставка, % годовых"
                                       Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Text="{Binding Application.AnnualInterestRate}" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="Срок, мес."
                                       Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Text="{Binding Application.TermMonths}" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="Ежемесячный платёж, ₽"
                                       Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Text="{Binding Application.MonthlyPayment, StringFormat='{}{0:N2}'}" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="Статус заявки"
                                       Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Text="{Binding Application.StatusText}"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Application.Status, Converter={StaticResource StatusToBrush}}" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="Дата подачи"
                                       Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Text="{Binding Application.CreatedAt, Converter={StaticResource DateTimeConverter}}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource SummaryCardStyle}"
                        Padding="18">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeaderBarStyle}">
                            <TextBlock Text="Автоматическая проверка"
                                       Style="{StaticResource SectionHeaderStyle}" />
                        </Border>

                        <!--
                            Блок вердикта: слева крупный балл, справа показатель долговой
                            нагрузки. Цвет фона задаётся выводом скоринга: зелёный при
                            одобрении, красный при отказе, жёлтый при пограничном ПДР.
                        -->
                        <Border CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,10"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource DangerSurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScoreApproved}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SuccessSurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsPaymentShareHigh}" Value="True" />
                                                <Condition Binding="{Binding IsScoreApproved}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="#FFF6E3" />
                                            <Setter Property="BorderBrush" Value="#D99A2B" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Балльная оценка крупным числом, как в личном кабинете банка. -->
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ScorePoints}"
                                               FontSize="40"
                                               FontWeight="Bold"
                                               TextAlignment="Center"
                                               Foreground="{Binding IsScoreApproved, Converter={StaticResource ApprovedBrush}}" />
                                    <TextBlock Text="баллов из 100"
                                               FontSize="11"
                                               Foreground="{StaticResource NeutralBrush}"
                                               TextAlignment="Center" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding ScoreConclusion}"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6" />

                                    <!-- ПДР: подпись, крупное значение и цветовая метка. -->
                                    <TextBlock Text="Долговая нагрузка (ПДР)"
                                               FontSize="11"
                                               Foreground="{StaticResource NeutralBrush}" />

                                    <WrapPanel Margin="0,2,0,0">
                                        <TextBlock Text="{Binding PaymentSharePercentText}"
                                                   FontSize="26"
                                                   FontWeight="Bold"
                                                   Margin="0,0,10,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPaymentShareHigh}" Value="True">
                                                            <Setter Property="Foreground" Value="#B07000" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsPaymentShareCritical}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Text="{Binding PaymentShareSummaryText}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource HintStyle}">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPaymentShareHigh}" Value="True">
                                                            <Setter Property="Foreground" Value="#B07000" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsPaymentShareCritical}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </WrapPanel>

                                    <TextBlock Text="{Binding PaymentShareText}"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <Border Style="{StaticResource SectionHeaderBarStyle}" Margin="0,0,0,4">
                                    <TextBlock Text="Решение по заявке"
                                               Style="{StaticResource SectionHeaderStyle}" />
                                </Border>
                                <TextBlock Text="{Binding Application.StatusText}"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Foreground="{Binding Application.Status, Converter={StaticResource StatusToBrush}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionHeaderBarStyle}" Margin="0,4,0,4">
                            <TextBlock Text="Замечания" Style="{StaticResource SectionHeaderStyle}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding Reasons}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,4"
                                               Foreground="{StaticResource DangerBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Комментарий специалиста" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding DecisionComment, UpdateSourceTrigger=PropertyChanged}"
                                 Height="90"
                                 Style="{StaticResource InputBoxStyle}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 Margin="0,0,0,12" />

                        <Button Content="Одобрить и открыть кредит"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ApproveCommand}"
                                IsEnabled="{Binding CanDecide}"
                                Margin="0,0,0,8" />

                        <Button Content="Отклонить заявку"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding RejectCommand}"
                                IsEnabled="{Binding CanDecide}"
                                Margin="0,0,0,8" />

                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="После решения заявка появится в списке с новым статусом."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>