<UserControl x:Class="AlfaBank.App.Views.Specialist.ApplicationQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AlfaBank.App.Converters"
             xmlns:infra="clr-namespace:AlfaBank.App.Infrastructure"
             Background="{StaticResource SurfaceBrush}">

    <UserControl.Resources>
        <converters:DateTimeConverter x:Key="DateTimeConverter" />
        <converters:StatusToBrushConverter x:Key="StatusToBrush" />
    </UserControl.Resources>

    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Статус заявки"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Statuses}"
                      SelectedItem="{Binding SelectedStatus}"
                      DisplayMemberPath="Title"
                      Style="{StaticResource InputComboBoxStyle}" />

            <Button Grid.Column="2"
                    Content="Обновить"
                    Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ReloadCommand}" />

            <Button Grid.Column="3"
                    Content="Проверить заявку"
                    Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding OpenReviewCommand}" />

            <TextBlock Grid.Column="4"
                       Style="{StaticResource HintStyle}"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"
                       Text="Выберите строку в таблице или дважды щёлкните по ней." />
        </Grid>

        <TextBlock DockPanel.Dock="Bottom"
                   Style="{StaticResource StatusMessageStyle}"
                   Text="{Binding StatusMessage}" />

        <DataGrid ItemsSource="{Binding Applications}"
                  SelectedItem="{Binding SelectedApplication}"
                  infra:ClearSelection.IsEnabled="True"
                  Style="{StaticResource DataGridHeaderStyle}"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenReviewCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50" />
                <DataGridTextColumn Header="Клиент" Binding="{Binding ClientFullName}" Width="2*" ElementStyle="{StaticResource DataGridWrapTextStyle}" />
                <DataGridTextColumn Header="Продукт" Binding="{Binding ProductName}" Width="2*" ElementStyle="{StaticResource DataGridWrapTextStyle}" />
                <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Amount, StringFormat='{}{0:N2}'}" Width="*" />
                <DataGridTextColumn Header="Срок, мес." Binding="{Binding TermMonths}" Width="90" />
                <DataGridTextColumn Header="Платёж, ₽" Binding="{Binding MonthlyPayment, StringFormat='{}{0:N2}'}" Width="*" />
                <DataGridTemplateColumn Header="Статус" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusText}"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Подана" Binding="{Binding CreatedAt, Converter={StaticResource DateTimeConverter}}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>