<UserControl x:Class="AlfaBank.App.Views.Admin.ProductManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AlfaBank.App.Converters"
             xmlns:infra="clr-namespace:AlfaBank.App.Infrastructure"
             Background="{StaticResource SurfaceBrush}">

    <UserControl.Resources>
        <converters:BooleanToStatusBrushConverter x:Key="ActiveBrush" />
    </UserControl.Resources>

    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PageHeaderBarStyle}">
                            <TextBlock Text="Кредитные продукты"
                                       Style="{StaticResource PageHeaderStyle}"
                                       Margin="0" />
                        </Border>

            <Button Grid.Column="1"
                    Content="Обновить справочник"
                    VerticalAlignment="Top"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ReloadCommand}" />
        </Grid>

        <TextBlock DockPanel.Dock="Bottom"
                   Style="{StaticResource StatusMessageStyle}"
                   Text="{Binding StatusMessage}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      Margin="0,0,12,0"
                      ItemsSource="{Binding Products}"
                      SelectedItem="{Binding SelectedProduct}"
                      infra:ClearSelection.IsEnabled="True"
                      Style="{StaticResource DataGridHeaderStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50" />
                    <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Ставка, %" Binding="{Binding AnnualInterestRate}" Width="90" />
                    <DataGridTextColumn Header="Мин., ₽" Binding="{Binding MinAmount, StringFormat='{}{0:N0}'}" Width="*" />
                    <DataGridTextColumn Header="Макс., ₽" Binding="{Binding MaxAmount, StringFormat='{}{0:N0}'}" Width="*" />
                    <DataGridTextColumn Header="Срок от, мес." Binding="{Binding MinTermMonths}" Width="90" />
                    <DataGridTextColumn Header="Срок до, мес." Binding="{Binding MaxTermMonths}" Width="90" />
                    <DataGridTemplateColumn Header="Активен" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="да"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding IsActive, Converter={StaticResource ActiveBrush}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Прокрутка формы: в невысоком окне кнопки сохранения иначе не видны. -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Border Style="{StaticResource SummaryCardStyle}"
                        Margin="0"
                        Padding="16">
                <StackPanel>
                    <TextBlock Text="Параметры продукта"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0,0,0,8" />

                    <!-- Показывает, создаётся новый продукт или редактируется существующий. -->
                    <Border CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource SuccessSurfaceBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditingExistingProduct}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentLightBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding FormModeText}" FontWeight="SemiBold" />
                    </Border>

                    <TextBlock Text="Наименование" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputBoxStyle}"
                             Margin="0,0,0,10" />

                    <TextBlock Text="Ставка, % годовых" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding AnnualInterestRate, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}"
                             Style="{StaticResource InputBoxStyle}"
                             Margin="0,0,0,10" />

                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="Мин. сумма, ₽" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding MinAmount, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:N0}'}" Style="{StaticResource InputBoxStyle}" />
                        </StackPanel>
                        <StackPanel Margin="5,0,0,0">
                            <TextBlock Text="Макс. сумма, ₽" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding MaxAmount, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:N0}'}" Style="{StaticResource InputBoxStyle}" />
                        </StackPanel>
                    </UniformGrid>

                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="Мин. срок, мес." Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding MinTermMonths, UpdateSourceTrigger=LostFocus}" Style="{StaticResource InputBoxStyle}" />
                        </StackPanel>
                        <StackPanel Margin="5,0,0,0">
                            <TextBlock Text="Макс. срок, мес." Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding MaxTermMonths, UpdateSourceTrigger=LostFocus}" Style="{StaticResource InputBoxStyle}" />
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="Описание" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             Height="80"
                             Style="{StaticResource InputBoxStyle}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,10" />

                    <CheckBox Content="Продукт доступен для заявок"
                              IsChecked="{Binding IsActive}"
                              Margin="0,0,0,14" />

                    <Button Content="Сохранить продукт"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SaveCommand}"
                            Margin="0,0,0,8" />

                    <Button Content="Новый продукт"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ClearCommand}"
                            Margin="0,0,0,8" />

                    <TextBlock Style="{StaticResource HintStyle}"
                               Text="«Новый продукт» очищает форму и переводит её в режим создания. Выбор строки в таблице, наоборот, открывает её для редактирования." />
                </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>