<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AlfaBank.Core — библиотечный проект предметной области:
    модели данных, контекст EF Core, миграции, демо-данные и бизнес-сервисы.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AlfaBank.Core</RootNamespace>
    <AssemblyName>AlfaBank.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.31" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.31">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
